# Copy this file to  .env  and fill in real values. NEVER commit .env.
#
# --- OmniRoute gateway (your local AI gateway) ---------------------------
# OmniRoute runs at http://localhost:20128 ; its OpenAI-compatible API is /v1.
# The key is whatever OmniRoute issues you in its dashboard (NOT a provider key).
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=put-your-omniroute-key-here
# Fail a dead cloud route fast (seconds) so we fall back quickly. Lower = snappier
# fallback but may cut off a slow-but-working reply. 8 suits flaky free routes.
CLOUD_TIMEOUT_SEC=8
LOCAL_TIMEOUT_SEC=60

# --- Cloud model routes --------------------------------------------------
# Use model IDs that ACTUALLY EXIST in your OmniRoute dashboard. Comma-separated
# lists are tried left to right. Verify each vision model is vision-capable.
TEXT_MODELS=meta-llama/llama-3.3-70b-instruct:free
VISION_MODELS=qwen/qwen2.5-vl-72b-instruct:free

# --- Local Ollama fallback (offline, free) -------------------------------
# Ollama is OpenAI-compatible at /v1. The api_key value is ignored by Ollama
# but the SDK requires a non-empty string.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# Text fallback model. Pick one `ollama list` shows. Bigger = better, slower.
OLLAMA_TEXT_MODEL=llama3.1:8b
# Local VISION fallback. Must be a vision model (e.g. qwen3-vl:2b). Leave blank
# to disable local vision and report "unavailable" when cloud vision fails.
OLLAMA_VISION_MODEL=qwen3-vl:2b

# --- Camera / observation scheduler --------------------------------------
CAMERA_INDEX=0
CAPTURE_FPS=5
FRAME_WIDTH=640
FRAME_HEIGHT=480
# Mean per-pixel grayscale difference (0-255) above which a scene "changed".
SCENE_CHANGE_THRESHOLD=12
# Minimum seconds between AUTOMATIC cloud vision observations.
OBSERVE_INTERVAL_SEC=10
# Max automatic cloud vision calls allowed per rolling hour (budget).
OBSERVE_HOURLY_BUDGET=20

# --- Provider cooldown ---------------------------------------------------
# After a rate-limit / server error, skip that model for this many seconds.
COOLDOWN_SEC=120
